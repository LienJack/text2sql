generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id                String    @id
  datasource        String
  workspaceId       String?
  createdByUserId   String?
  title             String    @default("新会话")
  modelCatalogId    String?
  modelProvider     String?
  modelName         String?
  debugEnabled      Boolean   @default(false)
  syncStatus        String    @default("healthy")
  syncFailedCount   Int       @default(0)
  lastMessageAt     DateTime?
  lastSyncFailureAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  messages          Message[]
  runs              SqlRun[]
  auditLogs         AgentAuditLog[]
  datasourceRef     Datasource @relation(fields: [datasource], references: [id], onDelete: Restrict)
  workspaceRef      Workspace? @relation("workspace_sessions", fields: [workspaceId], references: [id], onDelete: SetNull)
  modelCatalog      ModelCatalog? @relation(fields: [modelCatalogId], references: [id], onDelete: SetNull)

  @@index([deletedAt, lastMessageAt])
  @@index([workspaceId, deletedAt, lastMessageAt])
  @@index([createdByUserId])
  @@index([modelCatalogId])
  @@map("sessions")
}

model Datasource {
  id            String    @id
  name          String
  type          String
  status        String    @default("available")
  readonly      Boolean   @default(true)
  shared        Boolean   @default(true)
  config        String?
  fileMeta      String?
  unavailableAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  workspaceBindings WorkspaceDatasourceBinding[]
  tableAclRules WorkspaceDatasourceTableAcl[]

  @@index([deletedAt, status])
  @@index([type, status])
  @@map("datasources")
}

model Message {
  id        String   @id
  sessionId String
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("messages")
}

model SqlRun {
  runId         String   @id
  sessionId     String
  status        String
  provider      String
  model         String?
  question      String
  sql           String?
  explanation   String?
  answer        String?
  columns       String?
  rows          String?
  error         String?
  clarification String?
  trace         String
  llmRaw        String?
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  auditLogs         AgentAuditLog[]
  graphSnapshots    GraphSnapshot[]
  semanticEdges     SemanticEdge[]
  semanticMemories  SemanticMemory[]

  @@index([sessionId, createdAt])
  @@map("sql_runs")
}

model EvaluationReport {
  jobId     String   @id
  provider  String
  total     Int
  passed    Int
  passRate  Float
  payload   String
  createdAt DateTime @default(now())

  @@map("evaluation_reports")
}

model ProviderConfig {
  id               String   @id
  provider         String
  displayName      String
  baseUrl          String?
  apiKeyCiphertext String?
  apiKeyMasked     String?
  enabled          Boolean  @default(true)
  metadata         String?
  lastSyncAt       DateTime?
  lastSyncStatus   String   @default("idle")
  lastSyncError    String?
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  models           ModelCatalog[]

  @@index([provider, deletedAt])
  @@map("provider_configs")
}

model ModelCatalog {
  id                String   @id
  providerConfigId  String
  provider          String
  model             String
  displayName       String
  capabilities      String?
  contextWindow     Int?
  enabled           Boolean  @default(true)
  healthStatus      String   @default("unknown")
  lastHealthCheckAt DateTime?
  lastSyncedAt      DateTime?
  metadata          String?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  providerConfig    ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  sessions          Session[]

  @@unique([provider, model])
  @@index([enabled, deletedAt])
  @@index([providerConfigId])
  @@map("model_catalogs")
}

model PlatformUser {
  id                 String   @id
  account            String
  name               String
  email              String
  status             String   @default("active")
  isSystemAdmin      Boolean  @default(false)
  passwordHash       String?
  systemVariables    String?
  defaultWorkspaceId String?
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  defaultWorkspace   Workspace? @relation("workspace_default_users", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMembers   WorkspaceMember[]

  @@unique([account])
  @@unique([email])
  @@index([status, deletedAt])
  @@index([defaultWorkspaceId])
  @@map("platform_users")
}

model Workspace {
  id               String   @id
  name             String
  status           String   @default("active")
  isDefault        Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  defaultUsers     PlatformUser[] @relation("workspace_default_users")
  workspaceMembers WorkspaceMember[]
  sessions         Session[] @relation("workspace_sessions")
  datasourceBindings WorkspaceDatasourceBinding[]
  tableAclRules    WorkspaceDatasourceTableAcl[]

  @@unique([name])
  @@index([status, deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id
  userId      String
  workspaceId String
  role        String   @default("member")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
  @@index([userId, role])
  @@map("workspace_members")
}

model WorkspaceDatasourceBinding {
  id              String   @id
  workspaceId     String
  datasourceId    String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasource      Datasource @relation(fields: [datasourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, datasourceId])
  @@index([workspaceId, createdAt])
  @@index([datasourceId, createdAt])
  @@index([createdByUserId])
  @@map("workspace_datasource_bindings")
}

model WorkspaceDatasourceTableAcl {
  id              String   @id
  workspaceId     String
  datasourceId    String
  tableName       String
  subjectType     String
  subjectId       String
  effect          String   @default("allow")
  priority        Int      @default(100)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasource      Datasource @relation(fields: [datasourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, datasourceId, tableName, subjectType, subjectId])
  @@index([workspaceId, datasourceId, effect])
  @@index([workspaceId, datasourceId, subjectType, subjectId])
  @@index([createdByUserId])
  @@map("workspace_datasource_table_acls")
}

model AgentAuditLog {
  id        String   @id
  runId     String?
  sessionId String?
  phase     String
  severity  String   @default("info")
  eventType String
  eventCode String?
  message   String
  metadata  String?
  createdAt DateTime @default(now())
  run       SqlRun?  @relation(fields: [runId], references: [runId], onDelete: SetNull)
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([runId, createdAt])
  @@index([sessionId, createdAt])
  @@map("agent_audit_logs")
}

model GraphSnapshot {
  id           String   @id
  datasource   String
  graphType    String
  graphVersion Int      @default(1)
  status       String   @default("draft")
  checksum     String?
  payload      String
  sourceRunId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sourceRun    SqlRun?  @relation(fields: [sourceRunId], references: [runId], onDelete: SetNull)

  @@index([datasource, graphType, status])
  @@index([sourceRunId])
  @@map("graph_snapshots")
}

model SemanticEdge {
  id          String   @id
  datasource  String
  subjectKey  String
  predicate   String
  objectKey   String
  weight      Float?
  sourceRunId String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceRun   SqlRun?  @relation(fields: [sourceRunId], references: [runId], onDelete: SetNull)

  @@unique([datasource, subjectKey, predicate, objectKey])
  @@index([datasource, predicate])
  @@index([sourceRunId])
  @@map("semantic_edges")
}

model SemanticMemory {
  id           String   @id
  datasource   String
  semanticType String
  canonicalKey String
  content      String
  confidence   Float    @default(1.0)
  sourceRunId  String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sourceRun    SqlRun?  @relation(fields: [sourceRunId], references: [runId], onDelete: SetNull)

  @@unique([datasource, semanticType, canonicalKey])
  @@index([datasource, semanticType])
  @@index([sourceRunId])
  @@map("semantic_memories")
}
