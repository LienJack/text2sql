generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id                String    @id
  datasource        String
  workspaceId       String?
  createdByUserId   String?
  title             String    @default("新会话")
  modelCatalogId    String?
  modelProvider     String?
  modelName         String?
  debugEnabled      Boolean   @default(false)
  syncStatus        String    @default("healthy")
  syncFailedCount   Int       @default(0)
  lastMessageAt     DateTime?
  lastSyncFailureAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  messages          Message[]
  runs              SqlRun[]
  auditLogs         AgentAuditLog[]
  datasourceRef     Datasource @relation(fields: [datasource], references: [id], onDelete: Restrict)
  workspaceRef      Workspace? @relation("workspace_sessions", fields: [workspaceId], references: [id], onDelete: SetNull)
  modelCatalog      ModelCatalog? @relation(fields: [modelCatalogId], references: [id], onDelete: SetNull)

  @@index([deletedAt, lastMessageAt])
  @@index([workspaceId, deletedAt, lastMessageAt])
  @@index([createdByUserId])
  @@index([modelCatalogId])
  @@map("sessions")
}

model Datasource {
  id            String    @id
  name          String
  type          String
  status        String    @default("available")
  readonly      Boolean   @default(true)
  shared        Boolean   @default(true)
  config        String?
  fileMeta      String?
  unavailableAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  workspaceBindings WorkspaceDatasourceBinding[]
  workspaceTablePermissionSets WorkspaceDatasourceTablePermissionSet[]
  workspaceTablePermissions WorkspaceDatasourceTablePermission[]
  ragDocuments       RagDocument[]        @relation("datasource_rag_documents")
  ragChunks          RagChunk[]           @relation("datasource_rag_chunks")
  ragIndexVersions   RagIndexVersion[]    @relation("datasource_rag_index_versions")
  ragChunkIndexes    RagChunkIndexEntry[] @relation("datasource_rag_chunk_index_entries")
  ragRunReplays      RagRunReplay[]       @relation("datasource_rag_run_replays")

  @@index([deletedAt, status])
  @@index([type, status])
  @@map("datasources")
}

model Message {
  id        String   @id
  sessionId String
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("messages")
}

model SqlRun {
  runId         String   @id
  sessionId     String
  status        String
  provider      String
  model         String?
  question      String
  sql           String?
  explanation   String?
  answer        String?
  columns       String?
  rows          String?
  error         String?
  clarification String?
  trace         String
  llmRaw        String?
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  auditLogs         AgentAuditLog[]
  graphSnapshots    GraphSnapshot[]
  semanticEdges     SemanticEdge[]
  semanticMemories  SemanticMemory[]
  ragIndexVersionsBuilt     RagIndexVersion[] @relation("rag_index_created_by_run")
  ragIndexVersionsActivated RagIndexVersion[] @relation("rag_index_activated_by_run")
  ragRunReplays             RagRunReplay[]    @relation("rag_run_replays")

  @@index([sessionId, createdAt])
  @@map("sql_runs")
}

model GraphSnapshot {
  id          String   @id
  datasource  String
  graphType   String
  graphVersion Int     @default(1)
  status      String   @default("active")
  checksum    String?
  payload     String
  sourceRunId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceRun   SqlRun?  @relation(fields: [sourceRunId], references: [runId], onDelete: SetNull)

  @@index([datasource, graphType, status])
  @@index([sourceRunId])
  @@map("graph_snapshots")
}

model SemanticMemory {
  id           String   @id
  datasource   String
  semanticType String
  canonicalKey String
  content      String
  confidence   Float    @default(1)
  sourceRunId  String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sourceRun    SqlRun?  @relation(fields: [sourceRunId], references: [runId], onDelete: SetNull)

  @@unique([datasource, semanticType, canonicalKey])
  @@index([datasource, semanticType])
  @@index([sourceRunId])
  @@map("semantic_memories")
}

model SemanticEdge {
  id          String   @id
  datasource  String
  subjectKey  String
  predicate   String
  objectKey   String
  weight      Float?
  sourceRunId String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceRun   SqlRun?  @relation(fields: [sourceRunId], references: [runId], onDelete: SetNull)

  @@unique([datasource, subjectKey, predicate, objectKey])
  @@index([datasource, predicate])
  @@index([sourceRunId])
  @@map("semantic_edges")
}

model AgentAuditLog {
  id         String   @id
  runId      String?
  sessionId  String?
  phase      String
  severity   String   @default("info")
  eventType  String
  eventCode  String?
  message    String
  metadata   String?
  createdAt  DateTime @default(now())
  run        SqlRun?  @relation(fields: [runId], references: [runId], onDelete: SetNull)
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@map("agent_audit_logs")
}

model EvaluationReport {
  jobId     String   @id
  provider  String
  total     Int
  passed    Int
  passRate  Float
  payload   String
  createdAt DateTime @default(now())

  @@map("evaluation_reports")
}

model ProviderConfig {
  id               String   @id
  provider         String
  displayName      String
  baseUrl          String?
  apiKeyCiphertext String?
  apiKeyMasked     String?
  enabled          Boolean  @default(true)
  metadata         String?
  lastSyncAt       DateTime?
  lastSyncStatus   String   @default("idle")
  lastSyncError    String?
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  models           ModelCatalog[]

  @@index([provider, deletedAt])
  @@map("provider_configs")
}

model ModelCatalog {
  id                String   @id
  providerConfigId  String
  provider          String
  model             String
  displayName       String
  capabilities      String?
  contextWindow     Int?
  enabled           Boolean  @default(true)
  healthStatus      String   @default("unknown")
  lastHealthCheckAt DateTime?
  lastSyncedAt      DateTime?
  metadata          String?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  providerConfig    ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  sessions          Session[]

  @@unique([provider, model])
  @@index([enabled, deletedAt])
  @@index([providerConfigId])
  @@map("model_catalogs")
}

model PlatformUser {
  id                 String   @id
  account            String
  name               String
  email              String
  status             String   @default("active")
  isSystemAdmin      Boolean  @default(false)
  passwordHash       String?
  systemVariables    String?
  defaultWorkspaceId String?
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  defaultWorkspace   Workspace? @relation("workspace_default_users", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMembers   WorkspaceMember[]

  @@unique([account])
  @@unique([email])
  @@index([status, deletedAt])
  @@index([defaultWorkspaceId])
  @@map("platform_users")
}

model Workspace {
  id               String   @id
  name             String
  status           String   @default("active")
  isDefault        Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  defaultUsers     PlatformUser[] @relation("workspace_default_users")
  workspaceMembers WorkspaceMember[]
  sessions         Session[] @relation("workspace_sessions")
  datasourceBindings WorkspaceDatasourceBinding[]
  datasourceTablePermissionSets WorkspaceDatasourceTablePermissionSet[]
  datasourceTablePermissions WorkspaceDatasourceTablePermission[]

  @@unique([name])
  @@index([status, deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id
  userId      String
  workspaceId String
  role        String   @default("member")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
  @@index([userId, role])
  @@map("workspace_members")
}

model WorkspaceDatasourceBinding {
  id              String   @id
  workspaceId     String
  datasourceId    String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasource      Datasource @relation(fields: [datasourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, datasourceId])
  @@index([workspaceId, createdAt])
  @@index([datasourceId, createdAt])
  @@index([createdByUserId])
  @@map("workspace_datasource_bindings")
}

model WorkspaceDatasourceTablePermissionSet {
  id           String   @id
  workspaceId  String
  datasourceId String
  policyVersion Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasource   Datasource @relation(fields: [datasourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, datasourceId])
  @@index([workspaceId, datasourceId, policyVersion])
  @@map("workspace_datasource_table_permission_sets")
}

model WorkspaceDatasourceTablePermission {
  id           String   @id
  workspaceId  String
  datasourceId String
  tableName    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasource   Datasource @relation(fields: [datasourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, datasourceId, tableName])
  @@index([workspaceId, datasourceId, createdAt])
  @@map("workspace_datasource_table_permissions")
}

model RagDocument {
  id              String   @id
  datasourceId    String
  domain          String
  sourceType      String
  sourceRef       String?
  sourceVersion   String
  contentChecksum String
  title           String?
  content         String
  tableNames      String[]
  columnNames     String[]
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  datasource      Datasource @relation("datasource_rag_documents", fields: [datasourceId], references: [id], onDelete: Restrict)
  chunks          RagChunk[]
  replayLogs      RagRunReplay[]

  @@unique([datasourceId, sourceVersion, contentChecksum])
  @@index([datasourceId, domain])
  @@index([sourceType, sourceVersion])
  @@index([tableNames])
  @@index([columnNames])
  @@map("rag_documents")
}

model RagChunk {
  id              String   @id
  documentId      String
  datasourceId    String
  domain          String
  chunkProfile    String
  chunkOrder      Int
  content         String
  contentChecksum String
  tableNames      String[]
  columnNames     String[]
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  document        RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  datasource      Datasource  @relation("datasource_rag_chunks", fields: [datasourceId], references: [id], onDelete: Restrict)
  indexEntries    RagChunkIndexEntry[]
  replayLogs      RagRunReplay[]

  @@unique([documentId, chunkProfile, chunkOrder])
  @@index([datasourceId, domain, chunkProfile])
  @@index([tableNames])
  @@index([columnNames])
  @@map("rag_chunks")
}

model RagIndexVersion {
  id               String   @id
  datasourceId     String
  status           String
  buildReason      String?
  sourceVersion    String
  createdByRunId   String?
  activatedByRunId String?
  activatedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  datasource       Datasource @relation("datasource_rag_index_versions", fields: [datasourceId], references: [id], onDelete: Restrict)
  createdByRun     SqlRun?    @relation("rag_index_created_by_run", fields: [createdByRunId], references: [runId], onDelete: SetNull)
  activatedByRun   SqlRun?    @relation("rag_index_activated_by_run", fields: [activatedByRunId], references: [runId], onDelete: SetNull)
  chunkEntries     RagChunkIndexEntry[]
  replayLogs       RagRunReplay[]

  @@index([datasourceId, status, createdAt])
  @@index([createdByRunId])
  @@index([activatedByRunId])
  @@map("rag_index_versions")
}

model RagChunkIndexEntry {
  id             String   @id
  indexVersionId String
  chunkId        String
  datasourceId   String
  domain         String
  lexicalContent String
  denseVector    String?
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  indexVersion   RagIndexVersion @relation(fields: [indexVersionId], references: [id], onDelete: Cascade)
  chunk          RagChunk        @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  datasource     Datasource      @relation("datasource_rag_chunk_index_entries", fields: [datasourceId], references: [id], onDelete: Restrict)

  @@unique([indexVersionId, chunkId])
  @@index([datasourceId, domain])
  @@index([chunkId])
  @@map("rag_chunk_index_entries")
}

model RagRunReplay {
  runId          String
  replayKey      String
  datasourceId   String
  stage          String
  indexVersionId String?
  documentId     String?
  chunkId        String?
  payload        String
  createdAt      DateTime @default(now())
  run            SqlRun           @relation("rag_run_replays", fields: [runId], references: [runId], onDelete: Cascade)
  datasource     Datasource       @relation("datasource_rag_run_replays", fields: [datasourceId], references: [id], onDelete: Restrict)
  indexVersion   RagIndexVersion? @relation(fields: [indexVersionId], references: [id], onDelete: SetNull)
  document       RagDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chunk          RagChunk?        @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@id([runId, replayKey])
  @@index([datasourceId, stage, createdAt])
  @@index([indexVersionId])
  @@index([documentId])
  @@index([chunkId])
  @@map("rag_run_replays")
}
