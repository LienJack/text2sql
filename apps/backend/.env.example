PORT=3000
NODE_ENV=development
SQLITE_PATH=../../data/sqlite/text2sql.db
CORS_ALLOWED_ORIGINS=http://localhost:3001
DATASOURCE_UPLOAD_DIR=../../data/uploads/datasources
DATASOURCE_UPLOAD_MAX_BYTES=10485760
DATASOURCE_CONNECT_TIMEOUT_MS=5000
DATASOURCE_QUERY_TIMEOUT_MS=10000
DATASOURCE_SECRET_KEY=text2sql-dev-datasource-secret

REDIS_URL=redis://localhost:6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=text2sql
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_SCHEMA=public
# Optional: if set, DATABASE_URL takes precedence over POSTGRES_* variables.
# DATABASE_URL=postgresql://admin:admin@localhost:5432/text2sql?schema=public

LLM_PROVIDER=volcengine
LLM_MODEL=doubao-1.5-pro-32k
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
LLM_MOCK_MODE=false
LLM_FALLBACK_PROVIDERS=siliconflow,minimax
AGENT_PLANNING_SCAFFOLD_ENABLED=false
SQL_SAFETY_SOFT_WARN_MAX_LENGTH=600
R1_GATE_WINDOW_MINUTES=60
R1_GATE_MIN_SAMPLES=10
R1_GATE_MIN_SUCCESS_RATE=0.95
R1_GATE_MAX_REJECTION_RATE=0.2
R1_GATE_MAX_HARD_FAILURE_RATE=0.05

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=text2sql
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TIMEOUT_MS=5000
