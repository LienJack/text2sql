PORT=3000
NODE_ENV=development
SQLITE_PATH=../../data/sqlite/text2sql.db
CORS_ALLOWED_ORIGINS=http://localhost:3001

REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://text2sql:text2sql@localhost:5432/text2sql?schema=public

LLM_PROVIDER=volcengine
LLM_MODEL=doubao-1.5-pro-32k
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
LLM_MOCK_MODE=false
LLM_FALLBACK_PROVIDERS=siliconflow,minimax

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=text2sql
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TIMEOUT_MS=5000
