{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "e2e/.*\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/test/jest.setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@text2sql/shared-types$": "<rootDir>/../../packages/shared-types/src"
  }
}
