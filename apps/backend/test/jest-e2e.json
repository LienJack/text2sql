{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "e2e/.*\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/test/jest.setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@text2sql/analysis-task-protocol$": "<rootDir>/../../packages/analysis-task-protocol/src",
    "^@text2sql/chat-stream-protocol$": "<rootDir>/../../packages/chat-stream-protocol/src",
    "^@text2sql/chat-stream-protocol/(.*)$": "<rootDir>/../../packages/chat-stream-protocol/src/$1",
    "^@text2sql/shared-types$": "<rootDir>/../../packages/shared-types/src"
  }
}
