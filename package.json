{
  "name": "text2sql-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "prisma:studio": "pnpm --filter @text2sql/backend exec prisma studio",
    "db:studio": "pnpm --filter @text2sql/backend exec prisma studio",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @text2sql/backend test",
    "test:frontend": "pnpm --filter @text2sql/frontend test",
    "format:check": "pnpm -r lint"
  }
}
