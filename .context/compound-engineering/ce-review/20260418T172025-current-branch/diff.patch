+      const rows = Array.isArray(parsed)
+        ? parsed
+        : this.isRecord(parsed) && Array.isArray(parsed.reranked)
+          ? parsed.reranked
+          : [];
+      return rows
+        .map((row) => this.toRerankResult(row))
+        .filter((row): row is RerankCandidateResult => Boolean(row));
+    } catch {
