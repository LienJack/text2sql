+  private mergeRiskTags(...groups: Array<string[] | undefined>): string[] {
+    const merged = new Set<string>();
+    for (const group of groups) {
+      for (const riskTag of group ?? []) {
+        const normalized = riskTag.trim();
+        if (normalized) {
+          merged.add(normalized);
+        }
+      }
+    }
+    return [...merged];
+  }
+}
