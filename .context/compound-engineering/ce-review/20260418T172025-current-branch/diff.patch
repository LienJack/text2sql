+
+    quality.recordEvaluation({
+      runId: "run-r6-freeze-cache-hit",
+      datasourceId: "ds-r6-freeze",
+      sampleSize: 1200,
+      recallAt20: 0.92,
+      mrrAt10: 0.83,
+      retrievalRerankP95Ms: 620,
+      degradeRate: 0.02
